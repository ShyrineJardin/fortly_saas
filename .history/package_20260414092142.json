{
  "name": "fortly",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@lottiefiles/dotlottie-react": "^0.18.4",
    "axios": "^1.13.6",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "google-auth-library": "^10.5.0",
    "googleapis": "^170.1.0",
    "jsonwebtoken": "^9.0.2",
    "moment-timezone": "^0.6.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.12",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^6.30.3",
    "react-scripts": "5.0.1",
    "resend": "^6.9.2",
    "sequelize": "^6.35.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "set PORT=3000 && react-scripts start",
    "build": "react-scripts build",
    "server": "node server/index.js",
    "dev": "concurrently \"npm start\" \"npm run server\"",
    "test:unit": "jest tests/unit_tests --watchAll=false",
"test:integration": "jest tests/integration_tests --watchAll=false --runInBand"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "testMatch": [
          "<rootDir>/tests/unit_tests/**/*.test.{js,jsx,ts,tsx}"
        ],
        "testEnvironment": "jsdom",
        "transform": {
          "^.+\\.(js|jsx|ts|tsx)$": "babel-jest"
        },
        "transformIgnorePatterns": [
          "node_modules/(?!(axios)/)"
        ]
      },
      {
        "displayName": "integration",
        "testMatch": [
          "<rootDir>/tests/integration_tests/**/*.test.{js,jsx,ts,tsx}"
        ],
        "testEnvironment": "node",
        "testTimeout": 30000,
        "transform": {
          "^.+\\.(js|jsx|ts|tsx)$": "babel-jest"
        },
        "transformIgnorePatterns": [
          "node_modules/(?!(axios)/)"
        ]
      }
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.23",
    "babel-jest": "^30.3.0",
    "concurrently": "^8.2.2",
    "dotenv": "^17.4.2",
    "form-data": "^4.0.5",
    "jest": "^27.5.1",
    "jest-environment-jsdom": "^27.5.1",
    "nodemon": "^3.0.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^4.9.5"
  },
  "proxy": "http://localhost:5000"
}
